; Les Gardiens des Sources — configuration du projet.
;
; Ce fichier est lu par Godot au démarrage. Il n'a pas besoin d'être modifié à
; la main : l'éditeur le réécrit quand on change un réglage.

config_version=5

[application]

config/name="Les Gardiens des Sources"
run/main_scene="res://scenes/carte.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Partie="*res://scripts/partie.gd"

[display]

; La taille de référence est celle d'un iPhone récent tenu à l'horizontale :
; tout est dessiné pour cet écran-là, et le moteur met à l'échelle pour les
; autres. Le paysage donne au chemin la longueur qu'il lui faut — un tower
; defense se lit de gauche à droite.
window/size/viewport_width=844
window/size/viewport_height=390
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

; Le rendu de compatibilité : c'est celui qui passe partout sur mobile, y
; compris sur les appareils plus anciens.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
